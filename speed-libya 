
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Speed Libya</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#080d18;color:white;
 font-family:Arial,sans-serif;text-align:center;
 min-height:100vh;padding:25px 15px;
}
header{padding:20px}
.logo{font-size:30px;font-weight:bold;color:#00eaff}
.logo span{color:#fff}
.sub{color:#8995aa}
.panel{
 max-width:480px;margin:20px auto;
 background:#111b2c;border:1px solid #243751;
 border-radius:25px;padding:25px;
}
.gauge{
 width:220px;height:220px;border-radius:50%;
 margin:15px auto;display:flex;align-items:center;
 justify-content:center;
 background:conic-gradient(#00eaff 0deg,#17314a 0deg);
 position:relative;
}
.gauge:before{
 content:"";position:absolute;inset:10px;
 background:#111b2c;border-radius:50%;
}
.gauge-content{position:relative}
#speed{font-size:48px;font-weight:bold}
.unit{color:#9aacc5}
#status{color:#00eaff;margin:18px}
button{
 width:90%;padding:17px;border:0;border-radius:15px;
 background:#00d9ed;color:#06111b;font-size:19px;
 font-weight:bold;cursor:pointer;
}
button:disabled{opacity:.5}
.results{
 display:grid;grid-template-columns:repeat(3,1fr);
 gap:10px;margin-top:25px;
}
.result{
 background:#18263b;padding:17px 5px;border-radius:14px;
}
.result strong{display:block;font-size:23px;color:#00eaff}
.result small{color:#a5b4c9}
footer{color:#65748c;font-size:13px;margin:30px}
</style>
</head>
<body>

<header>
 <div class="logo">⚡ SPEED <span>LIBYA</span></div>
 <p class="sub">اختبر سرعة الإنترنت عندك</p>
</header>

<div class="panel">
 <div class="gauge" id="gauge">
  <div class="gauge-content">
   <div id="speed">0</div>
   <div class="unit">Mbps</div>
  </div>
 </div>

 <div id="status">جاهز لاختبار الإنترنت</div>
 <button id="start" onclick="startTest()">ابدأ الاختبار ⚡</button>

 <div class="results">
  <div class="result">
   <strong id="ping">--</strong>
   <small>Ping ms</small>
  </div>
  <div class="result">
   <strong id="download">--</strong>
   <small>Download</small>
  </div>
  <div class="result">
   <strong id="upload">--</strong>
   <small>Upload</small>
  </div>
 </div>
</div>

<footer>Speed Libya 🇱🇾 | اختبار سرعة الإنترنت</footer>

<script>
const $ = id => document.getElementById(id);

function showSpeed(value){
 $("speed").textContent = value.toFixed(1);
 const angle = Math.min(value / 100 * 360,360);
 $("gauge").style.background =
 `conic-gradient(#00eaff ${angle}deg,#17314a ${angle}deg)`;
}

async function pingTest(){
 let times=[];
 for(let i=0;i<5;i++){
  const start=performance.now();
  await fetch("https://speed.cloudflare.com/__down?bytes=0&t="+Date.now()+i,
  {cache:"no-store"});
  times.push(performance.now()-start);
 }
 times.sort((a,b)=>a-b);
 return times[2];
}

async function downloadTest(){
 const size=5000000;
 const start=performance.now();
 const response=await fetch(
 "https://speed.cloudflare.com/__down?bytes="+size+"&t="+Date.now(),
 {cache:"no-store"}
 );
 if(!response.ok) throw Error("Download failed");
 const data=await response.arrayBuffer();
 const seconds=(performance.now()-start)/1000;
 return (data.byteLength*8/seconds/1000000);
}

async function uploadTest(){
 const size=1000000;
 const data=new Uint8Array(size);
 const start=performance.now();
 const response=await fetch(
 "https://speed.cloudflare.com/__up?t="+Date.now(),
 {method:"POST",body:data}
 );
 if(!response.ok) throw Error("Upload failed");
 const seconds=(performance.now()-start)/1000;
 return (size*8/seconds/1000000);
}

async function startTest(){
 const btn=$("start");
 btn.disabled=true;
 $("ping").textContent="...";
 $("download").textContent="...";
 $("upload").textContent="...";
 showSpeed(0);

 try{
  $("status").textContent="جاري قياس Ping...";
  const p=await pingTest();
  $("ping").textContent=p.toFixed(0);

  $("status").textContent="جاري قياس سرعة التحميل...";
  const d=await downloadTest();
  $("download").textContent=d.toFixed(1);
  showSpeed(d);

  $("status").textContent="جاري قياس سرعة الرفع...";
  const u=await uploadTest();
  $("upload").textContent=u.toFixed(1);

  $("status").textContent="اكتمل الاختبار بنجاح! 🇱🇾";
 }catch(e){
  $("status").textContent="تعذر الاختبار، حاول مرة ثانية";
  console.error(e);
 }finally{
  btn.disabled=false;
 }
}
</script>
</body>
</html>
